<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_circle"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/settings"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <!-- ===== APPEARANCE ===== -->
            <TextView style="@style/SettingsSectionHeader" android:text="@string/section_appearance" />

            <LinearLayout
                android:id="@+id/rowTheme"
                style="@style/SettingsRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/SettingsRowTitle" android:text="@string/theme" />

                    <TextView
                        android:id="@+id/tvThemeValue"
                        style="@style/SettingsRowSubtitle" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- ===== HISTORY ===== -->
            <TextView style="@style/SettingsSectionHeader" android:text="@string/section_history" />

            <LinearLayout
                android:id="@+id/rowHistoryLimit"
                style="@style/SettingsRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/SettingsRowTitle" android:text="@string/history_limit" />

                    <TextView
                        android:id="@+id/tvHistoryLimitValue"
                        style="@style/SettingsRowSubtitle" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/rowClearHistory"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/clear_search_history" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- ===== NOTIFICATIONS ===== -->
            <TextView style="@style/SettingsSectionHeader" android:text="@string/section_notifications" />

            <LinearLayout style="@style/SettingsRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/SettingsRowTitle" android:text="@string/wotd_notification" />

                    <TextView
                        style="@style/SettingsRowSubtitle"
                        android:text="@string/wotd_notification_desc" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:contentDescription="@string/wotd_notification" />
            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/rowNotificationTime"
                style="@style/SettingsRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNotificationTimeLabel"
                        style="@style/SettingsRowTitle"
                        android:text="@string/reminder_time" />

                    <TextView
                        android:id="@+id/tvNotificationTimeValue"
                        style="@style/SettingsRowSubtitle" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivNotificationTimeChevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- ===== ACCOUNT ===== -->
            <TextView style="@style/SettingsSectionHeader" android:text="@string/section_account" />

            <LinearLayout
                android:id="@+id/rowLogout"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/logout"
                    android:textColor="@color/error"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- ===== ABOUT ===== -->
            <TextView style="@style/SettingsSectionHeader" android:text="@string/section_about" />

            <LinearLayout
                android:id="@+id/rowAbout"
                style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/about_wordspark" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@null" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
